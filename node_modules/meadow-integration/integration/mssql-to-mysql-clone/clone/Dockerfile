# Built from the meadow-integration repo root so the working tree can be layered
# over the published package — this image tests LOCAL code, not what npm ships.
FROM node:22-bookworm-slim

WORKDIR /harness/clone

COPY integration/mssql-to-mysql-clone/clone/package.json ./package.json
RUN npm install --no-audit --no-fund

# Patch the published meadow-integration with the local working tree.  The
# validation run asserts this landed before it trusts any other result.
COPY source /harness/clone/node_modules/meadow-integration/source

COPY integration/mssql-to-mysql-clone/shared /harness/shared
COPY integration/mssql-to-mysql-clone/clone/validate.js ./validate.js

CMD ["node", "validate.js", "4x"]
