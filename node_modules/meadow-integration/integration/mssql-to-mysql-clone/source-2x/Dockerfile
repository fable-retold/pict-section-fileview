FROM node:22-bookworm-slim

WORKDIR /harness/source-2x

# The legacy stack (fable 1.0.3 / meadow 1.0.35 / meadow-endpoints 2.1.1 /
# orator 2.0.10 / restify 6.4.0) installs and runs on modern node; it is pinned
# to the exact versions the Headlight API runs in production.
COPY source-2x/package.json ./package.json
RUN npm install --no-audit --no-fund

COPY shared /harness/shared
COPY source-2x/server.js ./server.js

EXPOSE 8086

CMD ["node", "server.js"]
