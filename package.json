{
    "name": "pict-section-fileview",
    "version": "1.0.0",
    "description": "A universal, embeddable file viewer: one control that detects a file's type (from a Sluice record or a bare range-served URL) and dispatches it to the right renderer — code, markdown, images (ordinary + enormous), PDF, video and audio — delegating each media kind to a purpose-built child section.",
    "main": "source/Pict-Section-Fileview.js",
    "scripts": {
        "test": "npx quack test",
        "tests": "npx quack test -g",
        "start": "node source/Pict-Section-Fileview.js",
        "coverage": "npx quack coverage",
        "build": "quack build",
        "example": "npx quack examples",
        "example-serve": "npx quack examples-serve",
        "types": "tsc -p ."
    },
    "quackageExamples": {
        "mode": "static"
    },
    "files": [
        "source"
    ],
    "directories": {
        "test": "test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fable-retold/pict-section-fileview.git"
    },
    "author": "steven velozo <steven@velozo.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/fable-retold/pict-section-fileview/issues"
    },
    "homepage": "https://github.com/fable-retold/pict-section-fileview#readme",
    "devDependencies": {
        "browser-env": "^3.3.0",
        "chai": "^4.3.0",
        "pict": "^1.0.372",
        "pict-application": "^1.0.34",
        "quackage": "^1.3.0",
        "typescript": "^5.9.3"
    },
    "mocha": {
        "diff": true,
        "extension": [
            "js"
        ],
        "package": "./package.json",
        "reporter": "spec",
        "slow": "75",
        "timeout": "5000",
        "ui": "tdd",
        "watch-files": [
            "source/**/*.js",
            "test/**/*.js"
        ]
    },
    "dependencies": {
        "pict-provider": "^1.0.13",
        "pict-view": "^1.0.68"
    }
}
